# ========================================================
# FindIt - Full-Stack Lost & Found Platform Environment
# ========================================================

# Server Configuration
PORT=3000
NODE_ENV=development
CLIENT_URL=http://localhost:3000
SERVER_URL=http://localhost:3000

# MongoDB Database Connection
# Example: mongodb://127.0.0.1:27017/lost_and_found or MongoDB Atlas URI
MONGODB_URI=mongodb://127.0.0.1:27017/lost_and_found

# JWT Authentication Secret Key
JWT_SECRET=write_random_secreat_lost_and_found

# Cloudinary Image Upload (Optional - Local Base64 fallback active if unset)
CLOUDINARY_CLOUD_NAME=your_cloudinary_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# SMTP / Nodemailer Email Notifications & OTP (Optional - Simulated OTP logger fallback active)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email_id
SMTP_PASSWORD=your_smtp_16digit_pass
SMTP_FROM="LostAndFoundWeb <youremail@gmail.com>"

# Frontend Configuration (Vite)
VITE_API_URL=http://localhost:5000/api
# Mapbox Public Access Token (Optional - Interactive vector map active with visual fallback if unset)
VITE_MAPBOX_TOKEN=your_mapbox_api_key
